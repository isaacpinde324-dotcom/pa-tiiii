  msgText.appendChild(small);
  msg.classList.add('in');
  if (flowerSeen === flowers.length && !b.dataset.last) { b.dataset.last = 1; setTimeout(() => FX.rain(24), 600); }
  if (flowerSeen >= 3) $('#next2').hidden = false;
