  return `<circle cx="${(Math.cos(a) * rr).toFixed(1)}" cy="${(Math.sin(a) * rr).toFixed(1)}" r=".9" fill="${col}"/>`; }).join('');
function flowerSVG(kind) {
  const hy = { daisy: 92, rose: 72, bud: 150, cosmos: 60, tulip: 104 }[kind];
  const side = kind === 'rose' || kind === 'cosmos' ? -1 : 1;
  const stem = `<path d="M60 268 C ${60 + side * 6} 230, ${60 - side * 8} ${hy + 60}, 60 ${hy}" stroke="url(#gStem)" stroke-width="3" fill="none" stroke-linecap="round"/>`;
  const ly = Math.max(hy + 50, 190);
  const leaf = `<path d="M60 ${ly + 20} C ${60 + side * 34} ${ly + 8}, ${60 + side * 40} ${ly - 18}, ${60 + side * 36} ${ly - 26} C ${60 + side * 18} ${ly - 18}, ${60 + side * 6} ${ly}, 60 ${ly + 20}Z" fill="url(#gLeaf)"/>
    <path d="M60 ${ly + 46} C ${60 - side * 26} ${ly + 38}, ${60 - side * 32} ${ly + 18}, ${60 - side * 30} ${ly + 10} C ${60 - side * 14} ${ly + 18}, ${60 - side * 4} ${ly + 30}, 60 ${ly + 46}Z" fill="url(#gLeaf)" opacity=".85"/>`;
  let head = '';
  if (kind === 'daisy') head = `<g class="ring1">${ring(16, PATH.thin, 1, 0, 'url(#gDaisy)', 'stroke="#ead7c4" stroke-width=".5"')}</g>
      <g class="ring2">${ring(16, PATH.thin, .78, 11, '#fdf3ea')}</g><circle r="9.5" fill="url(#gGold)"/>${dots(10, 7, '#a9803f')}`;
  if (kind === 'rose') head = `<g class="ring1">${ring(8, PATH.round, 1, 0, 'url(#gRose1)')}</g>
      <g class="ring2">${ring(7, PATH.round, .74, 24, 'url(#gRose2)')}</g><g class="ring3">${ring(5, PATH.round, .48, 8, '#dc96a0')}</g>
      <circle r="5.5" fill="#c97c88"/><path d="M-3 0a3 3 0 1 1 6 0" stroke="#f3cfd2" stroke-width=".8" fill="none"/>`;
  if (kind === 'cosmos') head = `<g class="ring1">${ring(8, PATH.notch, 1, 0, 'url(#gCosmos)', 'stroke="#e9b7c2" stroke-width=".4"')}</g>
      <circle r="8" fill="url(#gGold)"/>${dots(10, 6, '#9c7433')}`;
  if (kind === 'tulip') head = `<g class="ring1"><path d="M0 10C-24 6-26-24-14-42C-6-30-2-14 0 10Z" fill="url(#gTulip2)"/><path d="M0 10C24 6 26-24 14-42C6-30 2-14 0 10Z" fill="url(#gTulip2)"/></g>
      <g class="ring2"><path d="M0 12C-15 6-15-30 0-46C15-30 15 6 0 12Z" fill="url(#gTulip)"/></g>`;
  if (kind === 'bud') head = `<g class="bud-closed"><path d="M0 6C-10 1-11-19 0-30C11-19 10 1 0 6Z" fill="url(#gRose2)"/><path d="M0 8C-9 4-12-8-10-16C-5-8-2-2 0 8Z M0 8C9 4 12-8 10-16C5-8 2-2 0 8Z" fill="#9aab86"/></g>
      <g class="bud-petals"><g class="ring1">${ring(6, PATH.round, .78, 0, 'url(#gRose1)')}</g><g class="ring2">${ring(5, PATH.round, .5, 18, '#e3a3ab')}</g><circle r="5" fill="url(#gGold)"/></g>`;
  return `<svg viewBox="0 0 120 270" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false">
    <g class="lean"><g class="sway">${stem}${leaf}<g transform="translate(60 ${hy})"><g class="head">${head}</g></g></g></g></svg>`;
}
const HEAD_Y = { daisy: 92, rose: 72, bud: 150, cosmos: 60, tulip: 104 };
const garden = $('#garden'), msg = $('#msg'), msgText = $('#msgText');
const LABELS = { daisy: 'margarita', rose: 'rosa', bud: 'capullo', cosmos: 'flor rosa', tulip: 'tulipán' };
CONFIG.flores.forEach((f, i) => {
  const b = document.createElement('button');
  b.type = 'button'; b.className = 'flower f-' + f.tipo; b.dataset.i = i;
