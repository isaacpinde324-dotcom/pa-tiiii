const flowers = $$('.flower', garden);
let flowerSeen = 0;
garden.addEventListener('click', e => {
  const b = e.target.closest('.flower'); if (!b) return;
  const i = +b.dataset.i, f = CONFIG.flores[i];
  const head = b.querySelector('.head'); const [x, y] = center(head);
  b.classList.remove('tapped'); void b.getBBox; void b.offsetWidth; b.classList.add('tapped', 'open', 'seen');
  FX.burst(x, y, { petals: 14, sparks: 12, power: 5, up: true });
