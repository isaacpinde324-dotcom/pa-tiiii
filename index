// Las flores se inclinan suavemente hacia el cursor o el dedo
(() => {
  let rects = [], raf = 0, px = null;
  const measure = () => { rects = flowers.map(f => { const r = f.getBoundingClientRect(); return r.left + r.width / 2; }); };
  const apply = () => { raf = 0; flowers.forEach((f, i) => {
    const lean = px == null ? 0 : Math.max(-8, Math.min(8, (px - rects[i]) / innerWidth * 22));
    f.style.setProperty('--lean', lean.toFixed(2) + 'deg'); }); };
  const s2 = $('#s2');
  s2.addEventListener('pointermove', e => { if (RM) return; if (!rects.length) measure(); px = e.clientX; raf || (raf = requestAnimationFrame(apply)); }, { passive: true });
  s2.addEventListener('pointerleave', () => { px = null; raf || (raf = requestAnimationFrame(apply)); });
  addEventListener('resize', () => { rects = []; });
  onEnter[2] = () => { rects = []; };
})();
$('#next2').addEventListener('click', e => { const [x, y] = center(e.currentTarget); FX.burst(x, y, { petals: 16, sparks: 10, power: 6, up: true }); flashTo(3, x, y); });

/* ---------- Escena 3: tarjetas ---------- */
const ICONS = {
  sprout: '<path d="M12 21v-9"/><path d="M12 12C12 7.5 8.5 5 4 5c0 4.5 3.5 7 8 7z"/><path d="M12 14c0-4 3-6.5 8-6.5 0 4-3 6.5-8 6.5z"/>',
  mountain: '<path d="M2.5 19.5 9 9l3.6 5.4L15 11l6.5 8.5z"/><circle cx="17.5" cy="5.5" r="1.6"/>',
  path: '<path d="M5 20c3-1 5-4 6.5-7.5S15 6 19 4.5"/><circle cx="5" cy="20" r=".6"/><circle cx="19" cy="4.5" r="1.2"/><path d="M8 7.5l1 1M15 16l1 1M11 3.5l.6 1.2"/>',
  spark: '<path d="M12 3.5l1.9 5.6 5.6 1.9-5.6 1.9L12 18.5l-1.9-5.6L4.5 11l5.6-1.9z"/><path d="M19 17.5l.6 1.4 1.4.6-1.4.6-.6 1.4-.6-1.4-1.4-.6 1.4-.6z"/>',
  flower: '<circle cx="12" cy="10" r="2.2"/><path d="M12 7.8C10.5 5 11 3 12 2.5c1 .5 1.5 2.5 0 5.3zM14.2 10c2.8-1.5 4.8-1 5.3 0-.5 1-2.5 1.5-5.3 0zM12 12.2c1.5 2.8 1 4.8 0 5.3-1-.5-1.5-2.5 0-5.3zM9.8 10C7 11.5 5 11 4.5 10c.5-1 2.5-1.5 5.3 0z"/><path d="M12 17.5V22"/>',
  star: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><path d="M12 12l6-6M15.5 4.5 18 6l1.5 2.5"/>'
};
const cardsEl = $('#cards');
CONFIG.cualidades.forEach((c, i) => {
  const b = document.createElement('button');
  b.type = 'button'; b.className = 'card'; b.dataset.i = i; b.style.setProperty('--t1', c.t1); b.style.setProperty('--t2', c.t2);
  b.setAttribute('aria-pressed', 'false');
  b.innerHTML = `<span class="card-inner">
    <span class="face front" aria-hidden="false"><svg viewBox="0 0 24 24" aria-hidden="true">${ICONS[c.icono] || ICONS.spark}</svg>
      <span class="q">algo de ti</span><span class="t">Toca para descubrir</span></span>
    <span class="face back"><span class="rule" aria-hidden="true"></span><h3>${c.titulo}</h3><p>${c.frase}</p></span></span>`;
  b.setAttribute('aria-label', 'Tarjeta ' + (i + 1) + ', toca para descubrir una cualidad');
  cardsEl.appendChild(b);
});
let cardsSeen = 0;
cardsEl.addEventListener('click', e => {
  const b = e.target.closest('.card'); if (!b) return;
  const flipped = b.classList.toggle('flipped');
  b.setAttribute('aria-pressed', String(flipped));
  b.setAttribute('aria-label', flipped ? CONFIG.cualidades[b.dataset.i].titulo + ': ' + CONFIG.cualidades[b.dataset.i].frase : 'Tarjeta ' + (+b.dataset.i + 1) + ', toca para descubrir una cualidad');
  if (flipped) {
    const [x, y] = center(b);
    setTimeout(() => FX.burst(x, y, { petals: 6, sparks: 14, power: 4 }), 350);
    Music.chime([81, 86]);
    if (discover('card' + b.dataset.i)) cardsSeen++;
    if (cardsSeen >= 3) $('#next3').hidden = false;
    if (cardsSeen === CONFIG.cualidades.length && !cardsEl.dataset.done) { cardsEl.dataset.done = 1; setTimeout(() => toast('Seis cosas. Y seguro hay muchas más.'), 900); }
  }
});
$('#next3').addEventListener('click', e => { const [x, y] = center(e.currentTarget); flashTo(4, x, y); });

/* ---------- Escena 4: regalo ---------- */
const gift = $('#gift'), reveal = $('#reveal');
gift.addEventListener('click', () => {
  if (gift.classList.contains('open')) return;
  gift.classList.add('open'); gift.setAttribute('aria-expanded', 'true'); $('#giftHint').hidden = true;
  const [x, y] = center(gift);
  Music.chime([72, 76, 79, 84, 88]);
  setTimeout(() => { FX.burst(x, y - 30, { petals: 46, sparks: 40, power: 10, up: true }); }, RM ? 0 : 380);
  setTimeout(() => { FX.burst(x, y - 60, { petals: 18, sparks: 30, power: 7 }); FX.rain(30); }, RM ? 0 : 1100);
  setTimeout(() => { gift.classList.add('done'); reveal.classList.add('show'); discover('regalo'); }, RM ? 100 : 1000);
  setTimeout(() => { $('#next4').hidden = false; }, RM ? 300 : 3400);
});
$('#next4').addEventListener('click', e => { const [x, y] = center(e.currentTarget); flashTo(5, x, y); });

/* ---------- Escena 5: carta ---------- */
const envelope = $('#envelope'), letter = $('#letter'), body = $('#letterBody'), skip = $('#skip');
$('#letterOpen').textContent = CONFIG.saludo;
$('#signName').textContent = CONFIG.firma;
CONFIG.carta.forEach((txt, pi) => {
  const p = document.createElement('p'); p.className = 'ln' + (pi === CONFIG.carta.length - 1 ? ' last' : '');
  txt.split(' ').forEach((w, i) => { const s = document.createElement('span'); s.className = 'w'; s.style.setProperty('--i', i); s.textContent = w; p.append(s, ' '); });
  body.appendChild(p);
});
let letterRun = 0;
async function writeLetter() {
  const run = ++letterRun;
  const lines = $$('.ln', body);
  for (const p of lines) {
    if (run !== letterRun || letter.classList.contains('all')) break;
    p.classList.add('on');
    await sleep(RM ? 120 : p.children.length * 42 + 700);
  }
  if (run !== letterRun) return;
  finishLetter();
}
function finishLetter() {
  letter.classList.add('all'); $$('.ln', body).forEach(p => p.classList.add('on'));
  $('#sign').classList.add('on'); skip.hidden = true;
  if (discover('carta')) { const [x, y] = center($('#sign')); FX.burst(x, y, { petals: 10, sparks: 16, power: 4, up: true }); }
  $('#next5').hidden = false;
}
envelope.addEventListener('click', async () => {
  if (envelope.classList.contains('open')) return;
  envelope.classList.add('open'); $('#envHint').hidden = true; Music.chime([79, 83, 86]);
  const [x, y] = center(envelope); FX.burst(x, y, { petals: 8, sparks: 18, power: 4, up: true });
  await sleep(RM ? 0 : 1500);
  envelope.classList.add('gone');
  await sleep(RM ? 0 : 500);
  $('#envStage').hidden = true; letter.hidden = false; skip.hidden = false;
  await sleep(RM ? 0 : 900);
  writeLetter();
});
skip.addEventListener('click', () => { letterRun++; finishLetter(); });
letter.addEventListener('click', () => { if (!letter.classList.contains('all') && !letter.hidden) { letterRun++; finishLetter(); } });
$('#next5').addEventListener('click', e => { const [x, y] = center(e.currentTarget); flashTo(6, x, y); });

/* ---------- Escena 6: final ---------- */
const meadow = $('#meadow');
['tulip', 'daisy', 'rose', 'cosmos', 'daisy', 'rose', 'tulip', 'cosmos', 'daisy', 'rose', 'tulip'].forEach((k, i) => {
  const d = document.createElement('div'); d.className = 'mini'; d.style.setProperty('--k', i); d.innerHTML = flowerSVG(k); meadow.appendChild(d);
});
const star = $('#secretStar');
let starT;
onEnter[6] = () => {
  const ft = $('#finalText'); ft.classList.remove('play'); void ft.offsetWidth;
  requestAnimationFrame(() => ft.classList.add('play'));
  clearTimeout(starT); starT = setTimeout(() => star.classList.add('show'), RM ? 600 : 5200);
  setTimeout(() => FX.rain(18), 700);
};
star.addEventListener('click', () => {
  const [x, y] = center(star);
  FX.burst(x, y, { petals: 0, sparks: 40, power: 7 });
  Music.chime([84, 88, 91, 96]);
  star.classList.add('found'); discover('estrella');
  const ov = $('#secret'); ov.hidden = false; setTimeout(() => $('#secretClose').focus(), 300);
});
function closeSecret() { $('#secret').hidden = true; star.focus({ preventScroll: true }); }
$('#secretClose').addEventListener('click', e => { const [x, y] = center(e.currentTarget); FX.burst(x, y, { petals: 10, sparks: 14, power: 5, up: true }); closeSecret(); });
$('#secret').addEventListener('click', e => { if (e.target.id === 'secret') closeSecret(); });
addEventListener('keydown', e => { if (e.key === 'Escape' && !$('#secret').hidden) closeSecret(); });

$('#again').addEventListener('click', e => {
  const [x, y] = center(e.currentTarget);
  Music.chime([72, 76, 79, 84, 88, 91]);
  FX.burst(x, y, { petals: 40, sparks: 36, power: 10, up: true });
  meadow.classList.remove('celebrate'); void meadow.offsetWidth; meadow.classList.add('celebrate');
  $$('.mini', meadow).forEach((m, i) => setTimeout(() => { const [mx, my] = center(m.querySelector('.head')); FX.burst(mx, my, { petals: 5, sparks: 5, power: 4, up: true }); }, RM ? 0 : 200 + i * 90));
  FX.rain(40);
  setTimeout(() => { resetJourney(); flashTo(1, innerWidth / 2, innerHeight / 2); }, RM ? 400 : 2600);
});
function resetJourney() {
  flowers.forEach(f => f.classList.remove('open', 'tapped'));
  msg.classList.add('idle'); msg.classList.remove('in'); msgText.textContent = 'Tus flores siguen aquí. Puedes volver a tocarlas cuando quieras.';
  $$('.card', cardsEl).forEach(c => { c.classList.remove('flipped'); c.setAttribute('aria-pressed', 'false'); });
  gift.classList.remove('open', 'done'); gift.setAttribute('aria-expanded', 'false'); reveal.classList.remove('show'); $('#giftHint').hidden = false; $('#next4').hidden = true;
  letterRun++; envelope.classList.remove('open', 'gone'); $('#envStage').hidden = false; $('#envHint').hidden = false;
  letter.hidden = true; letter.classList.remove('all'); $$('.ln', body).forEach(p => p.classList.remove('on')); $('#sign').classList.remove('on'); skip.hidden = true; $('#next5').hidden = true;
  star.classList.remove('show'); meadow.classList.remove('celebrate');
}

